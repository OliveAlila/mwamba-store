# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
STORE_CURRENCY=KES
TRUST_PROXY=0

# Hostinger MySQL database details (create the database and user in hPanel)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Generate a random secret with at least 32 characters. Keep private.
JWT_SECRET=

# Paystack secret key must remain server-side. Use test keys while testing.
PAYSTACK_SECRET_KEY=
# Public HTTPS page that will handle the payment return on the deployed site.
PAYSTACK_CALLBACK_URL=https://your-domain.example/payment/return

# Used only for the one-time npm run create-admin command; never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=